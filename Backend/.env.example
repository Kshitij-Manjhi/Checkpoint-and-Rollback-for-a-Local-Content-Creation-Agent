# REQUIRED production stack: MySQL metadata + Git artifact repository + Chroma retrieval
AGENT_RUNTIME_STORAGE=mysql
AGENT_RUNTIME_MYSQL_URL=mysql://draftguard:CHANGE_ME@127.0.0.1:3306/draftguard
AGENT_RUNTIME_DATA_DIR=runtime_data
AGENT_ARTIFACT_GIT_DIR=runtime_data/artifact_repository
AGENT_EVIDENCE_DIR=runtime_data/evidence_index

# Local Ollama settings (Qwen should already be pulled locally)
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_SEMANTIC_EVALUATION=auto
# Optional: model used for semantic evaluation in template mode
# AGENT_QUALITY_MODEL=qwen3:4b

# Explicit development/test-only mode; does not enable Git/Chroma integrations:
# AGENT_RUNTIME_STORAGE=sqlite
# AGENT_RUNTIME_DB=runtime_data/runtime.sqlite3
